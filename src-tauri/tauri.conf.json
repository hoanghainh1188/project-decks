{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sheafly",
  "version": "1.1.0",
  "identifier": "com.hoanghainh.sheafly",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sheafly",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "THIRD_PARTY_LICENSES.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sheafly"
        ],
        "name": "Sheafly Project",
        "description": "Sheafly project",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-sheafly",
        "exportedType": {
          "identifier": "com.hoanghainh.sheafly.project",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "pdproj"
        ],
        "name": "Sheafly Project (older format)",
        "description": "Sheafly project (older format)",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-sheafly-pdproj",
        "exportedType": {
          "identifier": "com.hoanghainh.sheafly.pdproj",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ]
  }
}
